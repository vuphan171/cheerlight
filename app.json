{
  "expo": {
    "name": "CheerLight",
    "slug": "cheerlight",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "cheerlight",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.vuphan.cheerlight",
      "requireFullScreen": true,
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true,
        "UIStatusBarStyle": "UIStatusBarStyleLightContent"
      }
    },
    "android": {
      "package": "com.vuphan.cheerlight",
      "adaptiveIcon": {
        "backgroundColor": "#B000D8",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.WRITE_SETTINGS",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-font",
        {
          "ios": {
            "fonts": ["./assets/fonts/CheerLightDots-Regular.ttf", "./assets/fonts/Ionicons.ttf"]
          },
          "android": {
            "fonts": [
              {
                "fontFamily": "CheerLightDots",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/CheerLightDots-Regular.ttf",
                    "weight": 400
                  }
                ]
              },
              {
                "fontFamily": "Ionicons",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/Ionicons.ttf",
                    "weight": 400
                  }
                ]
              }
            ]
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#2C73D2",
          "image": "./assets/splash/splash-icon.png",
          "imageWidth": 273,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#2C73D2",
            "image": "./assets/splash/splash-icon.png"
          }
        }
      ],
      [
        "expo-screen-orientation",
        {
          "initialOrientation": "PORTRAIT_UP"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "CheerLight uses the camera only to turn on and blink the flash. It never takes photos or records video.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": ["en", "vi"],
            "android": ["en", "vi"]
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "backgroundColor": "#F2F2F7",
    "locales": {
      "vi": "./assets/locales/vi.json"
    }
  }
}
